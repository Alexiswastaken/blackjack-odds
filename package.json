{
  "name": "blackjack-odds",
  "productName": "Blackjack Odds",
  "private": true,
  "version": "1.1.0",
  "description": "Calculatrice de probabilites exactes de blackjack a partir de la composition reelle du sabot.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "electron:dev": "VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:build:mac": "npm run build && PYTHON_PATH=${PYTHON_PATH:-/usr/bin/python3} electron-builder --mac",
    "electron:build:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5",
    "zustand": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron@34.5.8": true,
    "fsevents@2.3.3": true
  }
}
